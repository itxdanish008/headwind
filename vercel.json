{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "django",
      "installCommand": "pip install -r requirements.txt",
      "devCommand": "python manage.py runserver 0.0.0.0:$PORT"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
